#!/usr/bin/env bash
set -euo pipefail
umask 077

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Path is resolved from this hook at runtime.
# shellcheck disable=SC1091
. "${PLUGIN_ROOT}/lib/install.sh"

workflow="${BUILDKITE_PLUGIN_GITHUB_ACTIONS_WORKFLOW:-${BUILDKITE_PLUGIN__WORKFLOW:-}}"
configured_version="${BUILDKITE_PLUGIN_GITHUB_ACTIONS_VERSION:-${BUILDKITE_PLUGIN__VERSION:-}}"
source_ref="${BUILDKITE_PLUGIN_GITHUB_ACTIONS_BUILDKITE_GHA_SOURCE_REF:-${BUILDKITE_PLUGIN__BUILDKITE_GHA_SOURCE_REF:-}}"
private_checkout="${BUILDKITE_PLUGIN_GITHUB_ACTIONS_PRIVATE_CHECKOUT:-${BUILDKITE_PLUGIN__PRIVATE_CHECKOUT:-false}}"

if [[ -z "$workflow" ]]; then
  echo "github-actions plugin: workflow is required" >&2
  exit 1
fi
if [[ "$workflow" == -* || "$workflow" == *$'\n'* || "$workflow" == *$'\r'* ]]; then
  echo "github-actions plugin: workflow must be a path, not an option or multiline value" >&2
  exit 1
fi
# An unrecognised value must not silently select either behaviour: treating it as
# false hides the opt-in, and treating it as true would widen authority.
case "$private_checkout" in
  true|false) ;;
  *) echo "github-actions plugin: private-checkout must be true or false" >&2; exit 1 ;;
esac
if [[ -n "$source_ref" && -n "$configured_version" ]]; then
  echo "github-actions plugin: version and buildkite-gha-source-ref are mutually exclusive" >&2
  exit 1
fi

case "$(uname -s)" in
  Linux) ;;
  *) echo "github-actions plugin: unsupported operating system '$(uname -s)'; only Linux x86-64 is supported" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64|amd64) ;;
  *) echo "github-actions plugin: unsupported architecture '$(uname -m)'; only Linux x86-64 is supported" >&2; exit 1 ;;
esac

if [[ ! "${BUILDKITE_COMMIT:-}" =~ ^[0-9a-f]{40}$ ]]; then
  gha_require git
  resolved_commit="$(git rev-parse --verify 'HEAD^{commit}' 2>/dev/null)" || {
    gha_error "failed to resolve the checked-out commit"
    exit 1
  }
  if [[ ! "$resolved_commit" =~ ^[0-9a-f]{40}$ ]]; then
    gha_error "checked-out commit did not resolve to a full lowercase 40-character commit"
    exit 1
  fi
  export BUILDKITE_COMMIT="$resolved_commit"
fi

echo "~~~ :github: Prepare workflow"

upload_args=(upload)
if [[ "$private_checkout" == true ]]; then
  upload_args+=(--private-checkout)
fi
upload_args+=(--runtime-queue hosted "$workflow")

if [[ -n "$source_ref" ]]; then
  resolved_source_ref="$source_ref"
  if [[ "$source_ref" == latest ]]; then
    gha_require git
    match="$(git ls-remote --exit-code --refs https://github.com/buildkite/buildkite-gha.git refs/heads/main 2>/dev/null)" || {
      gha_error "failed to resolve buildkite-gha source latest"
      exit 1
    }
    if [[ ! "$match" =~ ^([0-9a-f]{40})[[:space:]]+refs/heads/main$ ]]; then
      gha_error "buildkite-gha source latest did not resolve to exactly one commit"
      exit 1
    fi
    resolved_source_ref="${BASH_REMATCH[1]}"
    echo "github-actions plugin: buildkite-gha source latest resolved to $resolved_source_ref" >&2
  elif [[ ! "$source_ref" =~ ^[0-9a-f]{40}$ ]]; then
    gha_error "invalid buildkite-gha source ref '$source_ref'; expected latest or a full lowercase 40-character commit"
    exit 1
  fi
  gha_require mise
  echo "github-actions plugin: running buildkite-gha source at $resolved_source_ref with Go 1.26.5" >&2
  MISE_YES=1 mise --no-config x go@1.26.5 -- \
    env CGO_ENABLED=0 GOTOOLCHAIN=local \
    go run -trimpath "github.com/buildkite/buildkite-gha/cmd/buildkite-gha@${resolved_source_ref}" \
    "${upload_args[@]}"
else
  distribution="$(install_buildkite_gha "${configured_version:-0.6.0}")"
  trap 'rm -rf -- "$distribution"' EXIT
  "${distribution}/buildkite-gha" "${upload_args[@]}"
fi
