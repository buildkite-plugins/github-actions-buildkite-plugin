#!/usr/bin/env bash
set -euo pipefail
umask 077

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mise_data_dir_override="${MISE_DATA_DIR:-}"
for variable in "${!MISE_@}"; do
  unset "$variable"
done
if [[ -n "$mise_data_dir_override" ]]; then
  export MISE_DATA_DIR="$mise_data_dir_override"
fi
# Path is resolved from this hook at runtime.
# shellcheck disable=SC1091
. "${PLUGIN_ROOT}/lib/mise.sh"

configured_version="${BUILDKITE_PLUGIN_GITHUB_ACTIONS_VERSION:-}"
source_ref="${BUILDKITE_PLUGIN_GITHUB_ACTIONS_SOURCE_REF:-}"
minimum_release_age="${BUILDKITE_PLUGIN_GITHUB_ACTIONS_MINIMUM_RELEASE_AGE:-0s}"

if [[ -n "$source_ref" && -n "$configured_version" ]]; then
  echo "github-actions plugin: version and source-ref are mutually exclusive" >&2
  exit 1
fi
if [[ -n "$source_ref" && ! "$source_ref" =~ ^[0-9a-f]{40}$ ]] &&
  ! git check-ref-format "refs/heads/$source_ref"; then
  echo "github-actions plugin: invalid buildkite-gha source ref '$source_ref'; expected a full lowercase 40-character commit, branch, or tag" >&2
  exit 1
fi

configured_version="${configured_version:-latest}"
configured_version="${configured_version#v}"
if [[ "$configured_version" != latest ]]; then
  if [[ "$configured_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] &&
    (( BASH_REMATCH[1] > 0 || BASH_REMATCH[2] >= 9 )); then
    :
  else
    echo "github-actions plugin: invalid CLI version '$configured_version'; expected latest or an exact stable release from 0.9.0 onward" >&2
    exit 1
  fi
fi

host_os="$(uname -s)"
host_arch="$(uname -m)"
case "$host_os/$host_arch" in
  Linux/x86_64|Linux/amd64)
    host_platform=linux/amd64
    ;;
  Darwin/arm64|Darwin/aarch64)
    host_platform=darwin/arm64
    ;;
  *)
    echo "github-actions plugin: unsupported importer platform '$host_os/$host_arch'; only Linux amd64 and Darwin arm64 are supported" >&2
    exit 1
    ;;
esac

if [[ -n "$source_ref" && ! "$source_ref" =~ ^[0-9a-f]{40}$ ]]; then
  if ! remote_refs="$(git ls-remote --exit-code https://github.com/buildkite/buildkite-gha.git \
    "refs/heads/$source_ref" "refs/tags/$source_ref" "refs/tags/$source_ref^{}")"; then
    echo "github-actions plugin: could not resolve buildkite-gha source ref '$source_ref'" >&2
    exit 1
  fi
  branch_commit='' tag_commit='' peeled_commit=''
  while read -r commit ref; do
    case "$ref" in
      "refs/heads/$source_ref") branch_commit="$commit" ;;
      "refs/tags/$source_ref") tag_commit="$commit" ;;
      "refs/tags/$source_ref^{}") peeled_commit="$commit" ;;
    esac
  done <<< "$remote_refs"
  if [[ -n "$branch_commit" && -n "$tag_commit" ]]; then
    echo "github-actions plugin: source ref '$source_ref' matches both a branch and tag; use a full commit instead" >&2
    exit 1
  fi
  resolved_commit="${branch_commit:-${peeled_commit:-$tag_commit}}"
  if [[ ! "$resolved_commit" =~ ^[0-9a-f]{40}$ ]]; then
    echo "github-actions plugin: source ref '$source_ref' did not resolve to a full commit" >&2
    exit 1
  fi
  echo "github-actions plugin: resolved source ref '$source_ref' to $resolved_commit" >&2
  source_ref="$resolved_commit"
fi

echo "~~~ :github: Prepare workflows"

setup_mise "$host_platform"
export MISE_YES=1
if [[ -n "$source_ref" ]]; then
  runtime_dir="$(mktemp -d /tmp/buildkite-gha-source.XXXXXXXXXX)"
  trap 'rm -rf -- "$runtime_dir"' EXIT
  source_gopath="$runtime_dir/go"
  source_mod_cache="$MISE_DATA_DIR/github-actions-buildkite-plugin/go-mod-cache"

  for target in linux/amd64:LINUX darwin/arm64:DARWIN windows/amd64:WINDOWS; do
    platform="${target%:*}"
    runtime_environment="BUILDKITE_GHA_PLUGIN_DEV_${target##*:}_RUNTIME"
    echo "github-actions plugin: building $platform runtime from buildkite-gha source commit $source_ref with Go 1.26.5" >&2
    "$MISE_BIN" --no-config exec go@1.26.5 -- \
      env -u GOBIN CGO_ENABLED=0 GOTOOLCHAIN=local GOOS="${platform%/*}" GOARCH="${platform#*/}" GOPATH="$source_gopath" GOMODCACHE="$source_mod_cache" \
      go install -trimpath "github.com/buildkite/buildkite-gha/cmd/buildkite-gha@${source_ref}"

    runtime_path="$source_gopath/bin"
    if [[ "$platform" != "$host_platform" ]]; then
      runtime_path+="/${platform/\//_}"
    fi
    runtime_path+="/buildkite-gha"
    if [[ "$platform" == windows/* ]]; then
      runtime_path+=".exe"
    fi
    export "$runtime_environment=$runtime_path"
  done

  echo "github-actions plugin: running native $host_platform importer" >&2
  "$source_gopath/bin/buildkite-gha" plugin
else
  export MISE_GITHUB_GH_CLI_TOKENS=false
  export MISE_MINIMUM_RELEASE_AGE="$minimum_release_age"
  export MISE_QUIET=1
  exec "$MISE_BIN" --no-config exec \
    "github:buildkite/buildkite-gha@${configured_version}" \
    -- buildkite-gha plugin
fi
